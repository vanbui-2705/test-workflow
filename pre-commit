#!/usr/bin/env bash
# ============================================================
#  pre-commit hook (local) — monorepo-aware, fast tier only
#  Install: copy to <project>/.git/hooks/pre-commit && chmod +x
#  Runs lint + unit on every discovered py/js sub-project.
# ============================================================
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
echo "⚡ pre-commit: running fast test tier (monorepo-aware)..."
bash "$HOME/test-workflow/run-tests.sh" fast
